#include <iostream>
using namespace std;

int main() {
    long long x, n, result = 1;

    cout << "Enter the base (x): ";
    cin >> x;

    cout << "Enter the exponent (n): ";
    cin >> n;

    while (n > 0) {
        if (n % 2 == 1) {
            result *= x;
        }
        x *= x;
        n /= 2;
    }

    cout << "Result = " << result << endl;

    return 0;
}
