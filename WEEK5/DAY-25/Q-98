#include <iostream>
#include <set>
using namespace std;

int main() {
    string s1, s2;

    cout << "Enter first string: ";
    cin >> s1;

    cout << "Enter second string: ";
    cin >> s2;

    set<char> common;

    for (char c : s1) {
        for (char d : s2) {
            if (c == d)
                common.insert(c);
        }
    }

    cout << "Common characters: ";
    for (char c : common)
        cout << c << " ";

    return 0;
}
