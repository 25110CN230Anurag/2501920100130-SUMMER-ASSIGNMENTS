#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n, m;

    cout << "Enter size of first array: ";
    cin >> n;
    vector<int> a(n);

    cout << "Enter sorted elements of first array:\n";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    cout << "Enter size of second array: ";
    cin >> m;
    vector<int> b(m);

    cout << "Enter sorted elements of second array:\n";
    for (int i = 0; i < m; i++)
        cin >> b[i];

    vector<int> merged;
    int i = 0, j = 0;

    while (i < n && j < m) {
        if (a[i] <= b[j])
            merged.push_back(a[i++]);
        else
            merged.push_back(b[j++]);
    }

    while (i < n)
        merged.push_back(a[i++]);

    while (j < m)
        merged.push_back(b[j++]);

    cout << "Merged Array: ";
    for (int x : merged)
        cout << x << " ";

    return 0;
}
