#include <iostream>
#include <unordered_set>
using namespace std;

int main() {
    string str;
    cout << "Enter string: ";
    cin >> str;

    unordered_set<char> s;

    for (char ch : str) {
        if (s.find(ch) != s.end()) {
            cout << "First repeating character: " << ch;
            return 0;
        }
        s.insert(ch);
    }

    cout << "No repeating character found.";
    return 0;
}
