#include <iostream>
#include <vector>
using namespace std;

int findMissingNumber(vector<int>& arr, int n) {
    int totalSum = n * (n + 1) / 2;
    
    int arraySum = 0;
    for (int num : arr) {
        arraySum += num;
    }

    return totalSum - arraySum;
}

int main() {
    vector<int> arr = {1, 2, 4, 5, 6};
    int n = 6;   // Numbers are from 1 to 6

    cout << "Missing Number: " << findMissingNumber(arr, n) << endl;

    return 0;
}
