#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    srand(time(0));
    int secret = rand() % 100 + 1;
    int guess;

    cout << "=== Number Guessing Game ===\n";

    do {
        cout << "Enter your guess (1-100): ";
        cin >> guess;

        if (guess > secret)
            cout << "Too High!\n";
        else if (guess < secret)
            cout << "Too Low!\n";
        else
            cout << "Congratulations! You guessed the number.\n";

    } while (guess != secret);

    return 0;
}
