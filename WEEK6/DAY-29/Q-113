
#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int choice;
    double a, b, result;

    do {
        cout << "\n--- Menu-Driven Calculator ---\n";
        cout << "1. Addition\n2. Subtraction\n3. Multiplication\n";
        cout << "4. Division\n5. Modulus (integers)\n6. Power\n";
        cout << "7. Square Root\n8. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        if (choice == 8) {
            cout << "Exiting...\n";
            break;
        }

        if (choice == 7) {
            cout << "Enter number: ";
            cin >> a;
            if (a < 0) {
                cout << "Cannot calculate square root of negative number.\n";
            } else {
                cout << "Square root = " << sqrt(a) << endl;
            }
            continue;
        }

        cout << "Enter first number: ";
        cin >> a;
        cout << "Enter second number: ";
        cin >> b;

        switch (choice) {
            case 1:
                result = a + b;
                cout << "Result: " << result << endl;
                break;
            case 2:
                result = a - b;
                cout << "Result: " << result << endl;
                break;
            case 3:
                result = a * b;
                cout << "Result: " << result << endl;
                break;
            case 4:
                if (b == 0) {
                    cout << "Error: Division by zero.\n";
                } else {
                    result = a / b;
                    cout << "Result: " << result << endl;
                }
                break;
            case 5:
                if ((int)b == 0) {
                    cout << "Error: Modulus by zero.\n";
                } else {
                    cout << "Result: " << (int)a % (int)b << endl;
                }
                break;
            case 6:
                result = pow(a, b);
                cout << "Result: " << result << endl;
                break;
            default:
                cout << "Invalid choice.\n";
        }
    } while (choice != 8);

    return 0;
}
